<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EngUply — твой личный взлёт в английском</title>
    <!-- SEO Meta Tags -->
    <meta
      name="description"
      content="EngUply - бесплатное приложение для изучения английских слов и идиом. Интерактивные упражнения, социальные челленджи, персональный прогресс. Учите английский эффективно!"
    />
    <meta
      name="keywords"
      content="английский язык, изучение английского, слова, идиомы, упражнения, практика, бесплатно, приложение, EngUply"
    />
    <meta name="author" content="EngUply Team" />
    <!-- Anti-cache meta tags -->
    <meta
      http-equiv="Cache-Control"
      content="no-cache, no-store, must-revalidate"
    />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Russian" />
    <meta name="geo.country" content="Russia" />
    <meta name="geo.region" content="RU" />
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://enguply.com/" />
    <meta
      property="og:title"
      content="EngUply — твой личный взлёт в английском"
    />
    <meta
      property="og:description"
      content="Бесплатное приложение для изучения английских слов и идиом. Интерактивные упражнения, социальные челленджи, персональный прогресс."
    />
    <meta property="og:image" content="https://enguply.com/icons/icon-512.png" />
    <meta property="og:site_name" content="EngUply" />
    <meta property="og:locale" content="ru_RU" />
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://enguply.com/" />
    <meta
      property="twitter:title"
      content="EngUply — твой личный взлёт в английском"
    />
    <meta
      property="twitter:description"
      content="Бесплатное приложение для изучения английских слов и идиом. Интерактивные упражнения, социальные челленджи."
    />
    <meta
      property="twitter:image"
      content="https://enguply.com/icons/icon-512.png"
    />
    <!-- Canonical URL -->
    <link rel="canonical" href="https://enguply.com/" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="EngUply" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="css/chat.css" />
    <link rel="manifest" href="manifest.json" />
    <script src="js/lib/md5.min.js"></script>
    <script src="js/lib/confetti.browser.min.js"></script>
    <!-- Убрали xlsx.js для ускорения загрузки -->
    <!-- Если нужен импорт Excel - добавим локально позже -->
    <!-- Кеш пользовательских данных -->
    <script src="js/userDataCache.js"></script>
    <script src="js/wordBankDB.js"></script>
    <script src="js/storyBankDB.js"></script>
    <script src="api.js"></script>
    <script type="module" src="main.js"></script>
    <style>
      /* Убираем переход background-color чтобы избежать мерцания */
    </style>
</head>
  <body class="loading">
    <!-- Индикатор загрузки -->
    <div
      id="loading-indicator"
      style="
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--bg);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        z-index: 9999;
        opacity: 1;
        transition: opacity 0.3s ease;
      "
    >
      <div class="loading-spinner"></div>
      <div style="margin-top: 1rem; color: var(--text); font-size: 0.9rem">
        Загружаем EngUply...
      </div>
    </div>
    <header>
      <div class="logo">Eng<span>Uply</span></div>
      <nav>
        <button class="nav-btn" data-tab="words">
          <span class="material-symbols-outlined">menu_book</span>
          <span class="nav-text">Словарь</span>
        </button>
        <button class="nav-btn" data-tab="stories">
          <span class="material-symbols-outlined">auto_stories</span>
          <span class="nav-text">Истории</span>
        </button>
        <button class="nav-btn" data-tab="practice">
          <span class="material-symbols-outlined"> exercise </span>
          <span class="nav-text">Практика</span>
          <span class="badge" id="due-count">0</span>
        </button>
        <button class="nav-btn" data-tab="stats">
          <span class="material-symbols-outlined"> monitoring </span>
          <span class="nav-text">Статистика</span>
        </button>
        <button class="nav-btn" data-tab="friends">
          <span class="material-symbols-outlined">group</span>
          <span class="nav-text">Друзья</span>
          <span
            class="badge"
            id="friends-req-badge"
            style="display: none"
          ></span>
        </button>
      </nav>
      <div class="header-right">
        <!-- Индикатор серии -->
        <div class="streak-header-indicator" id="streak-header-indicator">
          <span class="material-symbols-outlined streak-fire-icon">local_fire_department</span>
          <span class="streak-header-count" id="streak-header-count">0</span>
        </div>
        <!-- Личный кабинет (будет виден только после авторизации) -->
        <div class="user-menu" id="user-menu">
          <button
            class="user-avatar"
            id="user-avatar"
            title="Меню пользователя"
          >
            <span class="material-symbols-outlined" style="font-size: 32px !important;">more_vert</span>
          </button>
          <div class="user-dropdown" id="user-dropdown" style="display: none">
            <div class="user-email" id="dropdown-email">
              <span class="material-symbols-outlined">person</span>
              <span>Загрузка...</span>
            </div>
            <div class="dropdown-item" id="dropdown-theme-toggle">
              <span class="material-symbols-outlined" id="theme-toggle-icon">dark_mode</span>
              <span id="theme-toggle-text">Ночной режим</span>
            </div>
            <div class="dropdown-divider"></div>
            <div class="dropdown-item" id="dropdown-speech-settings">
              <span class="material-symbols-outlined">tune</span>
              <span>Настройки</span>
            </div>
            <div class="dropdown-item" id="dropdown-start-tour">
              <span class="material-symbols-outlined">explore</span>
              <span>Обзор</span>
            </div>
            <div
              class="dropdown-item"
              id="dropdown-install-pwa"
              style="display: none"
            >
              <span class="material-symbols-outlined">download</span>
              <span>Приложение</span>
            </div>
            <div class="dropdown-divider"></div>
            <div class="dropdown-item" id="dropdown-logout">
              <span class="material-symbols-outlined">logout</span>
              <span>Выйти</span>
            </div>
          </div>
        </div>
      </div>
    </header>
    <!-- MOBILE BOTTOM NAVIGATION -->
    <nav class="mobile-bottom-nav" id="mobile-bottom-nav">
      <button class="mobile-nav-btn active" data-tab="words">
        <span class="material-symbols-outlined">menu_book</span>
        <span>Словарь</span>
      </button>
      <button class="mobile-nav-btn" data-tab="stories">
        <span class="material-symbols-outlined">auto_stories</span>
        <span>Истории</span>
      </button>
      <button class="mobile-nav-btn" data-tab="practice">
        <span class="material-symbols-outlined">exercise</span>
        <span>Практика</span>
        <span class="badge" id="mobile-due-count">0</span>
      </button>
      <button class="mobile-nav-btn" data-tab="stats">
        <span class="material-symbols-outlined">monitoring</span>
        <span>Статистика</span>
      </button>
      <button class="mobile-nav-btn" data-tab="friends">
        <span class="material-symbols-outlined">group</span>
        <span>Друзья</span>
        <span
          class="badge"
          id="mobile-friends-req-badge"
          style="display: none"
        ></span>
      </button>
    </nav>
    <main>
      <!-- TAB: WORDS -->
      <div class="tab-pane active" id="tab-words">
        <div class="no-speech" id="no-speech-banner">
          ⚠️ Ваш браузер не поддерживает синтез речи. Попробуйте Chrome.
        </div>
        <div id="wotd-wrap"></div>
        <div class="section-title">
          Мои слова <span class="section-subtitle" id="words-subtitle"></span>
        </div>
        <div class="words-toolbar">
          <div class="search-container">
            <span class="material-symbols-outlined search-icon">search</span>
            <input
              class="form-control"
              id="search-input"
              type="text"
              placeholder="Поиск..."
              autocomplete="off"
              autocorrect="off"
              spellcheck="false"
              name="q"
              data-form-type="search"
              aria-label="Поиск слов"
            />
          </div>
          <div class="filter-pills">
            <button class="pill active" data-filter="all">
              <span class="material-symbols-outlined list-icon">list</span> Все
            </button>
            <button class="pill" data-filter="learning">
              <span class="material-symbols-outlined learning-icon"
                >cognition_2</span
              >
              Учу
            </button>
            <button class="pill" data-filter="learned">
              <span class="material-symbols-outlined done-icon">done</span> Знаю
            </button>
            <div class="custom-select" id="sort-select-container">
              <button class="custom-select-trigger" id="sort-select-trigger">
                <span class="material-symbols-outlined">clock_loader_10</span>
                <span>Новые</span>
                <span class="material-symbols-outlined">expand_more</span>
              </button>
              <div class="custom-select-options" id="sort-select-options">
                <div class="custom-select-option active" data-value="date-desc">
                  <span class="material-symbols-outlined">clock_loader_10</span>
                  <span>Новые</span>
                </div>
                <div class="custom-select-option" data-value="date-asc">
                  <span class="material-symbols-outlined">clock_loader_80</span>
                  <span>Старые</span>
                </div>
                <div class="custom-select-option" data-value="alpha-asc">
                  <span class="material-symbols-outlined">sort_by_alpha</span>
                  <span>A → Z</span>
                </div>
                <div class="custom-select-option" data-value="alpha-desc">
                  <span class="material-symbols-outlined">sort_by_alpha</span>
                  <span>Z → A</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div id="words-grid" class="words-grid"></div>
        <div
          id="load-more-trigger"
          style="height: 1px; width: 100%; visibility: hidden"
        ></div>
        <div
          id="loading-more"
          style="display: none; text-align: center; padding: 1rem"
        >
          <div class="loading-spinner"></div>
          Загружаем ещё...
        </div>
        <div
          id="empty-words"
          style="
            display: none;
            text-align: center;
            padding: 3rem;
            color: var(--muted);
          "
        >
          <h3>Слов пока нет</h3>
          <p>Добавьте первое слово, чтобы начать учить английский!</p>
          <br />
        </div>
      </div>
      <!-- TAB: PRACTICE -->
      <div class="tab-pane" id="tab-practice">
        <div class="practice-wrap">
          <div class="setup-card" id="practice-setup">
            <div class="setup-row">
              <label>
                <span
                  class="material-symbols-outlined"
                  style="vertical-align: middle; margin-right: 8px"
                  >school</span
                >
                Режим
              </label>
              <div class="chip-group chip-group--modes" id="practice-mode">
                <button class="chip chip--mode on" data-mode="normal">
                  <span class="material-symbols-outlined">menu_book</span>
                  <span class="chip-label">Слова</span>
                  <span class="chip-badge" id="practice-words-due" style="display:none;"></span>
                </button>
                <!-- REMOVED: phrases functionality -->
                <!-- <button class="chip chip--mode" data-mode="phrases">
                  <span class="material-symbols-outlined">forum</span>
                  <span class="chip-label">Фразы</span>
                  <span class="chip-badge" id="practice-phrases-due" style="display:none;"></span>
                </button> -->
                <button class="chip chip--mode" data-mode="verbs">
                  <span class="material-symbols-outlined">psychology</span>
                  <span class="chip-label">Глаголы</span>
                </button>
              </div>
            </div>
            <!-- Блок настроек для экзамена (изначально скрыт) -->
            <div id="exam-settings" style="display: none">
              <div class="setup-row">
                <label>Длительность</label>
                <div class="chip-group">
                  <button class="chip" data-exam-time="300">
                    <span class="material-symbols-outlined">timer</span>
                    5 мин
                  </button>
                  <button class="chip on" data-exam-time="600">
                    <span class="material-symbols-outlined">timer</span>
                    10 мин
                  </button>
                  <button class="chip" data-exam-time="1200">
                    <span class="material-symbols-outlined">timer</span>
                    20 мин
                  </button>
                  <button class="chip" data-exam-time="1800">
                    <span class="material-symbols-outlined">timer</span>
                    30 мин
                  </button>
                </div>
              </div>
              <div class="setup-row">
                <label>Статистика</label>
                <div class="exam-stats-container">
                  <span id="exam-stats">12 слов • 50 сек/слово</span>
                </div>
              </div>
            </div>
            <div class="setup-row">
              <div class="exercise-grid">
                <div class="exercise-card" data-ex="flash">
                  <div class="exercise-icon">
                    <span class="material-symbols-outlined">style</span>
                  </div>
                  <div class="exercise-name">Карточки</div>
                  <div class="exercise-desc">
                    Переворачивай и запоминай
                  </div>
                </div>
                <div class="exercise-card" data-ex="multi">
                  <div class="exercise-icon">
                    <span class="material-symbols-outlined">quiz</span>
                  </div>
                  <div class="exercise-name">Выбор</div>
                  <div class="exercise-desc">
                    Найди правильный вариант
                  </div>
                </div>
                <div class="exercise-card" data-ex="builder">
                  <div class="exercise-icon">
                    <span class="material-symbols-outlined">construction</span>
                  </div>
                  <div class="exercise-name">Собери</div>
                  <div class="exercise-desc">
                    Составь слово из букв
                  </div>
                </div>
                <div class="exercise-card" data-ex="match">
                  <div class="exercise-icon">
                    <span class="material-symbols-outlined">extension</span>
                  </div>
                  <div class="exercise-name">Пары</div>
                  <div class="exercise-desc">
                    Соедини слово и перевод
                  </div>
                </div>
                <div class="exercise-card" data-ex="type">
                  <div class="exercise-icon">
                    <span class="material-symbols-outlined">keyboard</span>
                  </div>
                  <div class="exercise-name">Напиши</div>
                  <div class="exercise-desc">
                    Введи перевод слова
                  </div>
                </div>
                <div class="exercise-card" data-ex="dictation">
                  <div class="exercise-icon">
                    <span class="material-symbols-outlined">headphones</span>
                  </div>
                  <div class="exercise-name">Диктант</div>
                  <div class="exercise-desc">
                    Напиши, что слышишь
                  </div>
                </div>
                <!-- COMMENTED: Speech exercise - may add later -->
                <!--
                <div class="exercise-card" data-ex="speech">
                  <div class="exercise-icon">
                    <span class="material-symbols-outlined"
                      >record_voice_over</span
                    >
                  </div>
                  <div class="exercise-name">Скажи</div>
                  <div class="exercise-desc">
                    Тренируй произношение. пока прост HTML заккоментируй. может потом добавим.
                  </div>
                </div>
                -->
                <!-- COMMENTED: Sentence builder exercise - may remove later -->
                <!--
                <div class="exercise-card" data-ex="sentence-builder">
                  <div class="exercise-icon">
                    <span class="material-symbols-outlined">format_quote</span>
                  </div>
                  <div class="exercise-name">Собери предложение</div>
                  <div class="exercise-desc">
                    Составь предложение из слов
                  </div>
                </div>
                -->
              </div>
            </div>
            <div class="setup-row">
              <label>Количество заданий</label>
              <div class="chip-group">
                <button class="chip on" data-count="10">10</button>
                <button class="chip" data-count="20">20</button>
                <button class="chip" data-count="50">50</button>
                <button class="chip" data-count="all">Все</button>
              </div>
            </div>
            <div class="setup-row">
              <label>Слова для практики</label>
              <div class="chip-group" id="filter-chips-words">
                <button class="chip on" data-filter-w="all">
                  <span class="material-symbols-outlined">list</span>
                  Все
                </button>
                <button class="chip" data-filter-w="learning">
                  <span class="material-symbols-outlined">cognition_2</span>
                  Только учу <span class="chip-badge" id="learning-pill" style="display: none;">0</span>
                </button>
                <button class="chip" data-filter-w="due">
                  <span class="material-symbols-outlined">schedule</span>
                  К повторению <span class="chip-badge" id="due-pill">0</span>
                </button>
              </div>
              <div class="chip-group" id="filter-chips-verbs" style="display: none;">
                <button class="chip on" data-filter-w="often">Частые</button>
                <button class="chip" data-filter-w="all">Редкие</button>
              </div>
            </div>
            <div class="setup-row">
              <label
                ><span
                  class="material-symbols-outlined"
                  style="vertical-align: middle; margin-right: 8px"
                  >volume_up</span
                >Автопроизношение</label
              >
              <div class="chip-group">
                <button class="chip on" data-autopron="on">Включено</button>
                <button class="chip" data-autopron="off">Выключено</button>
              </div>
            </div>
            <div class="setup-row">
              <label
                ><span
                  class="material-symbols-outlined"
                  style="vertical-align: middle; margin-right: 8px"
                  >swap_horiz</span
                >Направление</label
              >
              <div class="chip-group">
                <button class="chip on" data-dir="both">EN + RU</button>
                <button class="chip" data-dir="en-ru">EN → RU</button>
                <button class="chip" data-dir="ru-en">RU → EN</button>
              </div>
            </div>
            <!-- ===== MOBILE TRIGGER BUTTON (только мобиле) ===== -->
            <div class="setup-row bs-trigger-row" id="bs-trigger-row">
              <button class="bs-trigger-btn" id="practice-bs-trigger">
                <div class="bs-trigger-left">
                  <span class="material-symbols-outlined bs-trigger-icon"
                    >tune</span
                  >
                  <div class="bs-trigger-text">
                    <span class="bs-trigger-label">Настройки</span>
                    <span class="bs-trigger-summary" id="bs-trigger-summary"
                      >Все слова · EN+RU ·
                      <span
                        class="material-symbols-outlined"
                        style="font-size: 16px; vertical-align: middle"
                        >volume_up</span
                      ></span
                    >
                  </div>
                </div>
                <span class="material-symbols-outlined bs-trigger-arrow"
                  >expand_more</span
                >
              </button>
            </div>
            <button
              class="pill"
              id="start-btn"
              style="
                width: 100%;
                margin-top: 0.5rem;
                display: flex;
                justify-content: center;
                align-items: center;
                background: var(--primary);
                border-color: var(--primary);
                color: #fff;
                padding: 0.6rem 1rem;
                font-size: 1rem;
              "
            >
              <span
                class="material-symbols-outlined"
                style="vertical-align: middle; margin-right: 8px"
                >rocket_launch</span
              >Начать!
            </button>
          </div>
          <div id="practice-ex" style="display: none">
            <div class="ex-wrap">
              <button class="ex-exit-btn" id="ex-exit-btn">
                <span class="material-symbols-outlined">logout</span>
              </button>
              <div class="ex-progress">
                <div class="ex-progress-info">
                  <span id="ex-counter">1 / 10</span>
                  <span id="ex-type-lbl"></span>
                </div>
                <div class="prog-bar">
                  <div class="prog-fill" id="prog-fill" style="width: 0%"></div>
                </div>
              </div>
              <div id="ex-content"></div>
              <div class="ex-btns" id="ex-btns"></div>
            </div>
          </div>
          <div id="practice-results" style="display: none">
            <div class="results-card">
              <div class="results-score" id="r-score">—</div>
              <div class="results-label" id="r-label">правильно</div>
              <svg
                class="results-ring"
                width="130"
                height="130"
                id="r-ring"
                style="margin: 0 auto 1.5rem; display: block"
              ></svg>
              <div class="breakdown" id="r-breakdown">
                <div class="breakdown-col">
                  <h4>
                    <span class="material-symbols-outlined">cancel</span> Ошибки
                  </h4>
                  <ul class="breakdown-list" id="r-wrong"></ul>
                </div>
              </div>
              <div
                style="
                  display: flex;
                  gap: 0.75rem;
                  justify-content: center;
                  flex-wrap: wrap;
                "
              >
                <div class="ex-actions">
                  <button class="btn-icon" id="repeat-btn">
                    <span class="material-symbols-outlined">refresh</span>
                  </button>
                  <button class="btn-icon" id="setup-btn">
                    <span class="material-symbols-outlined">close</span>
                  </button>
                  <div class="form-group">
                    <button
                      class="btn-pill btn-pill--secondary"
                      id="change-password-btn"
                      style="width: 100%"
                    >
                      <span class="material-symbols-outlined">vpn_key</span>
                      Сменить пароль
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- TAB: STATS -->
      <div class="tab-pane" id="tab-stats">
        <div class="xp-stats-row">
          <div class="xp-level">
            <span class="material-symbols-outlined">workspace_premium</span>
            <div class="xp-level-text">
              <span class="level-num" id="st-level-num">1</span>
              <span>уровень</span>
            </div>
          </div>
          <div class="xp-progress">
            <div class="xp-bar-wrap">
              <div class="xp-bar-bg">
                <div class="xp-bar-fill" id="xp-bar" style="width: 0%"></div>
              </div>
              <div class="xp-text" id="st-xp">0/200 XP</div>
            </div>
          </div>
        </div>
        <div class="stat-card streak-card" id="streak-card">
          <div class="stat-icon">
            <span class="material-symbols-outlined streak-fire-icon"
              >local_fire_department</span
            >
          </div>
          <div class="stat-content">
            <div class="stat-number" id="st-streak">0</div>
            <div class="stat-label" id="st-streak-label">дней подряд</div>
            <!-- Иконка выходного в карточке -->
            <div class="streak-card-freeze" id="streak-card-freeze" style="display: none;">
              <span class="material-symbols-outlined">beach_access</span>
            </div>
            <!-- Прогресс по сегодняшним критериям -->
            <div class="streak-daily-progress" id="streak-daily-progress" style="display: none;">
              <div class="streak-daily-time">
                <span class="material-symbols-outlined">schedule</span>
                <span id="streak-daily-progress-text">Осталось: 5:00</span>
              </div>
            </div>
            <!-- Прогресс до цели -->
            <div class="streak-progress-wrap">
              <div class="streak-progress-bar">
                <div class="streak-progress-fill" id="streak-progress-fill" style="width: 0%;"></div>
              </div>
              <div class="streak-progress-text" id="streak-progress-text">—</div>
            </div>
            <!-- Мотивационное сообщение -->
            <div class="streak-message" id="streak-message-wrap">
              <span class="streak-message-dot"></span>
              <span id="streak-message">Начни свою первую серию!</span>
            </div>
          </div>
        </div>
        <!-- Прогресс карточки -->
        <div id="st-progress-cards" class="st-progress-cards"></div>
        <div class="stats-grid">
          <div class="stat-card stat-card-full">
            <div class="stat-icon">
              <span class="material-symbols-outlined">emoji_events</span>
            </div>
            <div class="stat-content">
              <div class="stat-number" id="st-best">0</div>
              <div class="stat-label">Рекорд серии</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">
              <span class="material-symbols-outlined">check_circle</span>
            </div>
            <div class="stat-content">
              <div class="stat-number" id="st-week">0</div>
              <div class="stat-label">Серия точных ответов</div>
            </div>
          </div>
        </div>
        <div class="week-chart-container" id="week-chart-container">
          <div class="daily-cap-header">
            <span class="material-symbols-outlined">insights</span>
            <h3>Активность</h3>
          </div>
          <!-- Тепловая карта будет вставлена через JS -->
        </div>
        <!-- Daily Review Cap -->
        <div class="daily-cap-section">
          <div class="daily-cap-header">
            <span class="material-symbols-outlined">schedule</span>
            <h3>Лимит повторений</h3>
          </div>
          <div id="daily-cap-progress"></div>
        </div>
        <!-- Ежедневные цели -->
        <div class="daily-goals-section">
          <div class="daily-cap-header">
            <span class="material-symbols-outlined">track_changes</span>
            <h3>Ежедневные цели</h3>
          </div>
          <div class="goals-list" id="daily-goals-list"></div>
        </div>
        <!-- Уровни CEFR -->
        <div class="cefr-progress">
          <div class="daily-cap-header">
            <span class="material-symbols-outlined">school</span>
            <h3>Уровни слов (CEFR)</h3>
          </div>
          <div class="cefr-grid" id="cefr-grid"></div>
        </div>
        <div class="badges-section">
          <div class="daily-cap-header">
            <span class="material-symbols-outlined">emoji_events</span>
            <h3>Бейджи</h3>
          </div>
          <div class="badges-grid" id="badges-grid"></div>
        </div>
      </div>
      <!-- TAB: STORIES -->
      <div class="tab-pane" id="tab-stories">
        <!-- История дня -->
        <div id="story-bank-wrap" style="margin-bottom: 2rem"></div>
        <!-- Сетка для историй -->
        <div id="stories-grid" class="words-grid"></div>
        <!-- Пустое состояние -->
        <div
          id="empty-stories"
          style="
            display: none;
            text-align: center;
            padding: 3rem;
            color: var(--muted);
          "
        >
          <h3>Историй пока нет</h3>
          <p>Добавьте первую историю, чтобы запомнить её!</p>
          <br />
        </div>
      </div>
      <!-- TAB FRIENDS -->
      <div class="tab-pane" id="tab-friends">
        <!-- ЛИДЕРБОРД -->
        <div class="friends-leaderboard-section">
          <div class="daily-cap-header">
            <span class="material-symbols-outlined">emoji_events</span>
            <h3>Лидерборд</h3>
            <div class="lb-period-tabs">
              <button
                class="lb-tab active"
                data-period="week"
                data-short="Нед"
                onclick="switchLbPeriod(this)"
              >
                Неделя
              </button>
              <button
                class="lb-tab"
                data-period="month"
                data-short="Мес"
                onclick="switchLbPeriod(this)"
              >
                Месяц
              </button>
              <button
                class="lb-tab"
                data-period="all"
                data-short="Все"
                onclick="switchLbPeriod(this)"
              >
                Всё
              </button>
            </div>
          </div>
          <div id="friends-leaderboard-list" class="friends-leaderboard-list">
            <div class="loading-spinner"></div>
          </div>
        </div>
        <!-- ЛЕНТА АКТИВНОСТИ ДРУЗЕЙ -->
        <div class="friends-activity-section">
          <div class="daily-cap-header">
            <span class="material-symbols-outlined">notifications</span>
            <h3>Активность друзей</h3>
          </div>
          <div id="friend-activity-feed" class="friend-activity-feed">
            <div class="loading-spinner"></div>
          </div>
        </div>
        <!-- ПИЛЮЛИ: Друзья / Заявки -->
        <div class="friends-pills">
          <button class="pill active" id="pill-friends-list" data-fpill="list">
            <span class="material-symbols-outlined">people</span>
            <span>Друзья</span>
            <span class="friends-count-badge" id="friends-count-badge"></span>
          </button>
          <!-- ЗАКОММЕНТИРОВАНО: Вкладка челленджей -->
          <!--
          <button class="pill" id="pill-challenges" data-fpill="challenges">
            <span class="material-symbols-outlined">sports_score</span>
            <span>Челленджи</span>
          </button>
          -->
        </div>
        <!-- ПАНЕЛЬ: СПИСОК ДРУЗЕЙ -->
        <div class="friends-panel active" id="fpanel-list">
          <div id="friends-list-content">
            <div class="loading-spinner"></div>
          </div>
        </div>
        <!-- ЗАКОММЕНТИРОВАНО: Панель челленджей -->
        <!--
        Челленджи
        <div class="friends-panel" id="fpanel-challenges">
          <div
            id="challenge-invites-list"
            class="challenge-invites-section"
            style="display: none"
          >
            Приглашения
            <div
              id="challenge-invites-container"
              class="challenge-invites-list"
            ></div>
          </div>
          <div id="challenges-list" class="friends-leaderboard-list">
            Загрузка...
          </div>
          <div style="margin-top: 1rem">
