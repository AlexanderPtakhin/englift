    <!-- Модальное окно чтения истории -->
    <div class="modal-backdrop" id="read-story-modal" style="display:none;">
      <div class="modal-box" style="max-width: 800px">
        <div class="modal-header">
          <h3 id="read-story-title">История</h3>
          <button class="modal-close" id="read-story-modal-close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div class="modal-body" id="read-story-content">
          <!-- Контент истории будет здесь -->
        </div>
      </div>
    </div>
    <!-- Модальное окно добавления истории -->
    <div class="modal-backdrop" id="add-story-modal">
      <div class="modal-box" style="max-width: 500px">
        <div class="modal-header">
          <h3>Добавить историю</h3>
          <button class="modal-close" id="add-story-modal-close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <form id="add-story-form">
          <div class="form-group">
            <label>Название истории *</label>
            <input
              class="form-control"
              type="text"
              id="modal-story-title"
              name="study-story-title"
              required
              autocomplete="off"
              autocorrect="off"
              autocapitalize="sentences"
              spellcheck="false"
              inputmode="text"
              enterkeyhint="next"
            />
          </div>
          <div class="form-group">
            <label>Текст истории *</label>
            <textarea
              class="form-control"
              id="modal-story-text"
              name="study-story-text"
              required
              autocomplete="off"
              autocorrect="off"
              autocapitalize="sentences"
              spellcheck="false"
              rows="6"
            ></textarea>
          </div>
          <div class="form-group">
            <label>Перевод *</label>
            <textarea
              class="form-control"
              id="modal-story-translation"
              name="study-story-translation"
              required
              autocomplete="off"
              autocorrect="off"
              autocapitalize="sentences"
              spellcheck="false"
              rows="6"
            ></textarea>
          </div>
          <div class="form-group">
            <label>Теги</label>
            <input class="form-control" type="text" id="modal-story-tags" name="study-story-tags" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" inputmode="text" enterkeyhint="done" />
          </div>
          <div class="form-group">
            <label>
              <input type="checkbox" id="modal-story-scheduled" name="study-story-scheduled">
              Отложенная публикация (в 0:00 UTC следующего дня)
            </label>
          </div>
          <button
            type="submit"
            class="btn-pill btn-pill--secondary"
            style="width: 100%"
          >
            <span class="material-symbols-outlined">add</span>
            Добавить историю
          </button>
        </form>
      </div>
    </div>
    <!-- Модальное окно добавления слова -->
    <div class="modal-backdrop" id="add-word-modal">
      <div class="modal-box" style="max-width: 500px">
        <div class="modal-header">
          <h3>Добавить слово</h3>
          <button class="modal-close" id="add-word-modal-close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <form id="add-word-form">
          <div class="form-group">
            <label>Английское слово *</label>
            <div style="position: relative">
              <input
                class="form-control"
                type="text"
                id="modal-word-en"
                name="study-word-en"
                required
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                inputmode="text"
                enterkeyhint="next"
              />
              <div
                id="autocomplete-suggestions"
                class="autocomplete-suggestions"
              ></div>
            </div>
          </div>
          <div class="form-group">
            <label>Русский перевод *</label>
            <div style="position: relative">
              <input
                class="form-control"
                type="text"
                id="modal-word-ru"
                name="study-word-ru"
                required
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                inputmode="text"
                enterkeyhint="next"
              />
              <div
                id="ru-autocomplete-suggestions"
                class="autocomplete-suggestions"
              ></div>
            </div>
          </div>
          <div class="form-group">
            <label>Пример</label>
            <input class="form-control" type="text" id="modal-word-ex" name="study-example-en" autocomplete="off" autocorrect="off" autocapitalize="sentences" spellcheck="false" inputmode="text" enterkeyhint="next" />
          </div>
          <div class="form-group">
            <label>Перевод примера</label>
            <input
              class="form-control"
              type="text"
              id="modal-word-ex-translation"
              name="study-example-ru"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              inputmode="text"
              enterkeyhint="next"
            />
          </div>
          <div class="form-group">
            <label>Теги через запятую</label>
            <input class="form-control" type="text" id="modal-word-tags" name="study-tags" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" inputmode="text" enterkeyhint="done" />
          </div>
          <button
            type="submit"
            id="add-word-submit-btn"
            class="btn-pill btn-pill--secondary"
            style="width: 100%"
          >
            <span class="material-symbols-outlined">add</span>
            Добавить слово
          </button>
        </form>
      </div>
    </div>
    <div class="modal-backdrop" id="del-modal">
      <div class="modal-box">
        <h3>Удалить слово?</h3>
        <p>Это действие нельзя отменить.</p>
        <div class="modal-actions">
          <button class="btn-icon" id="del-confirm">
            <span class="material-symbols-outlined">check</span>
          </button>
          <button class="btn-icon" id="del-cancel">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
      </div>
    </div>
    <!-- Модальное окно уведомления о выходном -->
    <div class="modal-backdrop" id="freeze-notification-modal">
      <div class="modal-box">
        <div class="modal-header">
          <h3><span class="material-symbols-outlined">beach_access</span> Выходной</h3>
          <button class="modal-close" id="freeze-notification-modal-close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div class="modal-body">
          <p>Выходной использован на этой неделе. Ваша серия сохранена!</p>
        </div>
      </div>
    </div>
    <!-- Speech Settings Modal — ТОЛЬКО ЛИМИТ ПОВТОРЕНИЙ (речь убрана) -->
    <div class="modal-backdrop" id="speech-modal">
      <div class="modal-box modal-box--large">
        <div class="modal-header">
          <h3>
            <span class="material-symbols-outlined">tune</span>
            Настройки
          </h3>
          <button class="modal-close" id="speech-modal-close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div class="modal-grid" style="grid-template-columns: 1fr">
          <!-- Только лимит повторений -->
          <div class="modal-col">
            <div class="settings-card">
              <h4>
                <span class="material-symbols-outlined">settings</span>
                Настройки
              </h4>
              <p>Выбери голос озвучки и лимит повторений.</p>
              <div class="form-group">
                <label>Голос озвучки</label>
                <select id="voice-select" class="form-control">
                  <option value="female">Женский голос</option>
                  <option value="male">Мужской голос</option>
                </select>
              </div>
              <div class="form-group">
                <label>Лимит в день</label>
                <select id="review-limit-select" class="form-control">
                  <option value="50">50 — лёгкий (10–20 мин)</option>
                  <option value="80">80 — комфортный</option>
                  <option value="100" selected>100 — рекомендовано</option>
                  <option value="150">150 — интенсив</option>
                  <option value="200">200 — мощный</option>
                  <option value="9999">Без лимита</option>
                </select>
                <div
                  id="current-limit-info"
                  class="limit-info"
                  style="margin-top: 0.5rem"
                ></div>
              </div>
              <div class="form-group">
                <label>Цветовая тема</label>
                <select id="theme-base-select" class="form-control">
                  <option value="lavender">Янтарь (по умолчанию)</option>
                  <option value="ocean">Океан</option>
                  <option value="forest">Лес</option>
                  <option value="purple">Лаванда</option>
                  <option value="sunset">Закат</option>
                  <option value="sky">Небесная</option>
                  <option value="sand">Песок</option>
                  <option value="graphite">Графит</option>
                </select>
              </div>
              <div class="form-group">
                <label style="display: flex; align-items: center; gap: 0.5rem">
                  <input type="checkbox" id="show-phonetic" checked />
                  <span>Показывать транскрипцию в карточках</span>
                </label>
                <small class="form-text" style="color: var(--muted)"
                  >Отображение /ˈfəʊniːtɪk/ рядом со словом</small
                >
              </div>
              <div class="form-group">
                <label>Уровень слов в рекомендациях</label>
                <select id="bank-word-level-select" class="form-control">
                  <option value="all">Все уровни</option>
                  <option value="A1">A1 (начальный)</option>
                  <option value="A2">A2 (базовый)</option>
                  <option value="B1">B1 (средний)</option>
                  <option value="B2">B2 (выше среднего)</option>
                  <option value="C1">C1 (продвинутый)</option>
                  <option value="C2">C2 (профессиональный)</option>
                </select>
              </div>
              <div class="form-group">
                <button
                  class="btn-pill btn-pill--secondary"
                  id="change-password-btn-settings"
                  style="width: 100%"
                >
                  <span class="material-symbols-outlined">vpn_key</span> Сменить
                  пароль
                </button>
              </div>
              <div class="form-group">
                <button class="btn-pill btn-pill--secondary" id="download-words-btn" onclick="window.downloadWords()" style="width: 100%">
                  <span class="material-symbols-outlined">download</span> Скачать слова
                </button>
              </div>
              <div
                class="form-group"
                style="text-align: center; margin-top: 1.5rem"
              >
                <button class="btn-primary" id="speech-modal-save">
                  <span class="material-symbols-outlined">save</span>
                  Сохранить
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-actions"></div>
        <div class="danger-actions">
          <h4>
            <span class="material-symbols-outlined">warning</span> Опасные
            действия
          </h4>
          <button class="danger-btn" id="clear-words-btn">
            <span class="material-symbols-outlined">delete_forever</span>
            Очистить весь словарь (слова + идиомы)
          </button>
          <!-- Новая кнопка сброса прогресса -->
          <button class="danger-btn" id="reset-progress-btn">
            <span class="material-symbols-outlined">restart_alt</span>
            Сбросить весь прогресс
          </button>
          <button class="danger-btn" id="delete-account-btn">
            <span class="material-symbols-outlined">delete_forever</span>
            Удалить аккаунт
          </button>
        </div>
      </div>
    </div>
    <!-- Confirmation Modal -->
    <div class="modal-backdrop" id="confirm-modal">
      <div class="modal-box">
        <h3>
          <span class="material-symbols-outlined" style="vertical-align: middle"
            >warning</span
          >
          Подтвердите действие
        </h3>
        <p id="confirm-message"></p>
        <input
          type="text"
          id="confirm-input"
          placeholder="Введите текст для подтверждения"
          style="
            width: 100%;
            margin: 1rem 0;
            padding: 0.5rem;
            border: 1px solid var(--border);
            border-radius: 4px;
          "
        />
        <small
          id="confirm-hint"
          style="color: var(--muted); display: block; margin-bottom: 1rem"
        ></small>
        <div class="modal-actions">
          <button class="danger-btn" id="confirm-action">
            <span class="material-symbols-outlined">delete</span>
            Подтвердить
          </button>
          <button class="btn-icon" id="cancel-confirm">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
      </div>
    </div>
    <div id="toast-box"></div>
    <!-- Блок для неподтверждённого email -->
    <!-- Change Password Modal -->
    <div class="modal-backdrop" id="change-password-modal">
      <div class="modal-box" style="max-width: 420px">
        <div class="modal-header">
          <h3
            style="color: var(--text); text-align: center; margin-bottom: 1rem"
          >
            <span
              class="material-symbols-outlined"
              style="
                vertical-align: middle;
                margin-right: 8px;
                color: var(--primary);
              "
              >vpn_key</span
            >
            Смена пароля
          </h3>
          <button class="modal-close" id="change-password-modal-close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <form id="change-password-form">
          <div class="form-group">
            <label style="color: var(--text); font-weight: 600"
              >Текущий пароль</label
            >
            <div class="input-with-icon">
              <span class="material-symbols-outlined input-icon">lock</span>
              <div class="password-field-wrapper">
                <input
                  type="password"
                  id="current-password"
                  class="form-control"
                  placeholder="Введите текущий пароль"
                  required
                  autocomplete="current-password"
                  readonly
                  onfocus="this.removeAttribute('readonly')"
                />
                <button
                  type="button"
                  class="password-toggle"
                  id="current-password-toggle"
                >
                  <span class="material-symbols-outlined">visibility</span>
                </button>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label style="color: var(--text); font-weight: 600"
              >Новый пароль</label
            >
            <div class="input-with-icon">
              <span class="material-symbols-outlined input-icon">lock</span>
              <div class="password-field-wrapper">
                <input
                  type="password"
                  id="new-password"
                  class="form-control"
                  placeholder="Минимум 8 символов: A-Z, a-z, 0-9, !@#$%"
                  required
                  minlength="8"
                  autocomplete="new-password"
                  readonly
                  onfocus="this.removeAttribute('readonly')"
                />
                <button
                  type="button"
                  class="password-toggle"
                  id="new-password-toggle"
                >
                  <span class="material-symbols-outlined">visibility</span>
                </button>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label style="color: var(--text); font-weight: 600"
              >Подтвердите пароль</label
            >
            <div class="input-with-icon">
              <span class="material-symbols-outlined input-icon">lock</span>
              <div class="password-field-wrapper">
                <input
                  type="password"
                  id="confirm-new-password"
                  class="form-control"
                  placeholder="Повторите новый пароль"
                  required
                  minlength="8"
                  autocomplete="new-password"
                  readonly
                  onfocus="this.removeAttribute('readonly')"
                />
                <button
                  type="button"
                  class="password-toggle"
                  id="confirm-new-password-toggle"
                >
                  <span class="material-symbols-outlined">visibility</span>
                </button>
              </div>
            </div>
          </div>
          <div class="modal-actions">
            <button
              type="button"
              class="btn-pill btn-pill--secondary"
              style="flex: 1"
              id="change-password-submit"
            >
              <span class="material-symbols-outlined">check</span> Сменить
            </button>
            <button
              type="button"
              class="btn-pill btn-pill--secondary"
              style="flex: 1"
              id="change-password-cancel"
            >
              <span class="material-symbols-outlined">close</span> Отмена
            </button>
          </div>
        </form>
      </div>
    </div>
    <!-- ===== BOTTOM SHEET для настроек практики ===== -->
    <div class="bs-backdrop" id="practice-bs-backdrop"></div>
    <div
      class="bottom-sheet"
      id="practice-bottom-sheet"
      aria-modal="true"
      role="dialog"
    >
      <!-- Ручка для свайпа -->
      <div class="bs-drag-area" id="bs-drag-area">
        <div class="bs-handle"></div>
      </div>
      <div class="bs-body">
        <!-- РАЗДЕЛ 1: Слова для практики -->
        <div class="bs-section">
          <div class="bs-section-label" id="bs-filter-section-label">
            <span class="material-symbols-outlined">filter_list</span>
            Слова для практики
          </div>
          <div class="bs-option-list" id="bs-filter-list">
            <button class="bs-option active" data-bs-filter-w="all">
              <span class="material-symbols-outlined bs-opt-icon">list</span>
              <span class="bs-opt-text">Все слова</span>
              <span class="material-symbols-outlined bs-opt-check"
                >check_circle</span
              >
            </button>
            <button class="bs-option" data-bs-filter-w="learning">
              <span class="material-symbols-outlined bs-opt-icon"
                >cognition_2</span
              >
              <span class="bs-opt-text">
                Учу
                <span class="bs-learning-badge" id="learning-pill-mobile" style="display: none;">0</span>
              </span>
              <span class="material-symbols-outlined bs-opt-check"
                >check_circle</span
              >
            </button>
            <button class="bs-option" data-bs-filter-w="due">
              <span class="material-symbols-outlined bs-opt-icon"
                >schedule</span
              >
              <span class="bs-opt-text">
                К повторению
                <span class="bs-due-badge" id="bs-due-badge">0</span>
              </span>
              <span class="material-symbols-outlined bs-opt-check"
                >check_circle</span
              >
            </button>
          </div>
        </div>
        <div class="bs-divider"></div>
        <!-- РАЗДЕЛ 2: Количество слов -->
        <div class="bs-section">
          <div class="bs-section-label">
            <span class="material-symbols-outlined">format_list_numbered</span>
            Количество слов
          </div>
          <div class="bs-seg" id="bs-count-seg">
            <button class="bs-seg-btn active" data-bs-count="10">10</button>
            <button class="bs-seg-btn" data-bs-count="20">20</button>
            <button class="bs-seg-btn" data-bs-count="50">50</button>
            <button class="bs-seg-btn" data-bs-count="all">Все</button>
          </div>
        </div>
        <div class="bs-divider"></div>
        <!-- РАЗДЕЛ 3: Автопроизношение -->
        <div class="bs-section">
          <div class="bs-section-label">
            <span class="material-symbols-outlined">volume_up</span>
            Автопроизношение
          </div>
          <div class="bs-seg" id="bs-autopron-seg">
            <button class="bs-seg-btn active" data-bs-autopron="on">
              <span class="material-symbols-outlined">volume_up</span>
            </button>
            <button class="bs-seg-btn" data-bs-autopron="off">
              <span class="material-symbols-outlined">volume_off</span>
            </button>
          </div>
        </div>
        <div class="bs-divider"></div>
        <!-- РАЗДЕЛ 3: Направление -->
        <div class="bs-section" id="bs-dir-section">
          <div class="bs-section-label">
            <span class="material-symbols-outlined">swap_horiz</span>
            Направление
          </div>
          <div class="bs-seg" id="bs-dir-seg">
            <button class="bs-seg-btn active" data-bs-dir="both">EN+RU</button>
            <button class="bs-seg-btn" data-bs-dir="en-ru">EN→RU</button>
            <button class="bs-seg-btn" data-bs-dir="ru-en">RU→EN</button>
          </div>
        </div>
      </div>
    </div>
    <!-- GLOBAL FEEDBACK SHEET -->
    <div class="fb-sheet" id="fb-sheet">
      <div class="fb-sheet-bar"></div>
      <div class="fb-sheet-inner" id="fb-sheet-inner"></div>
    </div>
    <div class="fb-backdrop" id="fb-backdrop"></div>
    <script src="tour.js"></script>
  </body>
</html>
