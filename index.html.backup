              <span class="material-symbols-outlined">add</span> Создать
              челлендж
            </button>
          </div>
        </div>
        -->
        </div>
      </div>
    </main>
    <!-- Плавающая кнопка добавления друга (только для вкладки друзей) -->
    <button
      class="floating-add-btn floating-add-friend-btn"
      id="floating-add-friend-btn"
      style="display: none"
    >
      <span class="material-symbols-outlined">person_add</span>
    </button>
    <!-- Плавающая кнопка добавления слова -->
    <button class="floating-add-btn" id="floating-add-word-btn">
      <span class="material-symbols-outlined">add</span>
    </button>
    <!-- Плавающая кнопка добавления истории отключена -->
    <!--
    <button class="floating-add-btn" id="floating-add-story-btn" style="display:none;">
      <span class="material-symbols-outlined">auto_stories</span>
    </button>
    -->
    <!-- Плавающая кнопка чата -->
    <button
      class="floating-add-btn floating-chat-btn"
      id="floating-chat-btn"
      style="display: none"
    >
      <span class="material-symbols-outlined">chat</span>
      <span class="badge" id="floating-chat-badge" style="display: none"
        >0</span
      >
    </button>
    <!-- Модальное окно поиска друзей -->
    <div class="modal-backdrop" id="add-friend-modal">
      <div class="modal-box" style="max-width: 500px">
        <div class="modal-header">
          <h3>Найти друга</h3>
          <button class="modal-close" id="add-friend-modal-close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div class="modal-body">
          <!-- Кнопка пригласить по ссылке -->
          <button
            class="btn-pill btn-pill--secondary"
            id="invite-friend-link-btn"
            style="width: 100%; margin-bottom: 1rem"
          >
            <span class="material-symbols-outlined">share</span>
            Пригласить по ссылке
          </button>
          <div class="search-container" style="margin-bottom: 1rem">
            <span class="material-symbols-outlined search-icon">search</span>
            <input
              class="form-control"
              id="add-friend-search-input"
              type="text"
              placeholder="Email или имя пользователя..."
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              name="friend-search"
              inputmode="text"
            />
          </div>
          <div id="add-friend-search-results"></div>
        </div>
      </div>
    </div>
    <!-- ЗАКОММЕНТИРОВАНО: Модальное окно создания челленджа -->
